    "react-dom": "^19.2.7",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
